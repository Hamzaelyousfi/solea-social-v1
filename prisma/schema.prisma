generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  FOLLOW_UP
  ARCHIVED
}

enum TrafficSource {
  DIRECT
  INSTAGRAM
  GOOGLE
  LINKEDIN
  FACEBOOK
  REFERRAL
  OTHER
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Contact {
  id          String        @id @default(cuid())
  name        String
  email       String
  company     String?
  budget      String?
  projectType String?
  subject     String?
  message     String
  status      ContactStatus @default(NEW)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, createdAt])
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

model BlogPost {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  excerpt     String
  category    String
  coverImage  String?
  coverEmoji  String         @default("📝")
  coverFrom   String         @default("from-orange-400")
  coverTo     String         @default("to-rose-400")
  author      String         @default("Amandine Veillard")
  authorRole  String         @default("Fondatrice de Solea Socials")
  readTime    Int            @default(5)
  tags        String[]
  content     Json           @default("[]")
  featured    Boolean        @default(false)
  status      BlogPostStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, publishedAt])
  @@index([slug])
}

model PageView {
  id        String        @id @default(cuid())
  path      String
  referrer  String?
  source    TrafficSource
  utmSource String?
  utmMedium String?
  userAgent String?
  createdAt DateTime      @default(now())

  @@index([createdAt])
  @@index([source, createdAt])
}
